# look configuration
# Generated by Look. Edit values below, then press Save Config to apply.

# Indexing
file_scan_roots=Desktop,Documents,Downloads,Pictures,Videos
file_scan_extra_roots=
file_scan_depth=8
file_scan_limit=8000
file_exclude_paths=
ignored_patterns_sample=
ignored_patterns_migrations=~/Documents/git/hospital-management-system/server/Infrastructure/Migrations/*.cs|~/Documents/git/edux/**/Migrations/*.cs
# File ignore patterns. Format: ignored_patterns_<group>=Pattern1|Pattern2|Pattern3
# ignored_patterns_browser=~/AppData/Local/BraveSoftware/**/*.log|~/AppData/Local/Google/Chrome/**/*.tmp
# ignored_patterns_sqlite=~/Documents/git/project/**/*.db-wal|~/Documents/git/project/**/*.db-shm
lazy_indexing_enabled=true
skip_dir_names=node_modules,target,build,dist,.git,vendor,out,coverage,tmp,cache,venv, Extras

# Arch (and other affected stacks) - workarounds for WebKitGTK ghost rendering.
# arch_disable_gpu forces HardwareAccelerationPolicy::Never (needs restart);
# arch_disable_blur drops backdrop-filter for an opaque tint. Both default off;
# flip if you see slider trails or overlapping popovers.
arch_disable_gpu=false
arch_disable_blur=false

# Running apps switcher: none, right
running_apps_placement=right

# Clipboard history size (10-100). Out-of-range values fall back to 10.
clipboard_history_limit=15

# Preferred tools. Name the tool, not a command: Look knows how to drive it,
# including running a terminal editor inside your terminal. Declare nothing and
# nothing changes. Editing uses text_editor on a file and code_editor on a
# folder; declaring only one of the two covers both.
# Acted on from the row's action menu, and from Cmd+E / Cmd+T (Ctrl elsewhere).
text_editor=nvim
code_editor=nvim
terminal=wezterm
file_manager=thunar

# Home-screen inner gap in px (0-24). 0 keeps the classic framed panel;
# above 0 the home screen splits into floating tiles separated by this gap.
inner_gap=7

# Web answers - inline answer card for question-like queries. Set false to
# disable all network answer features and run fully offline.
ai_enabled=true

# Super actions - empty-state launchpad of quick toggles / actions. Set
# false to hide the strip and disable its keyboard accelerators.
super_actions_enabled=true

# UI theme (empty = built-in default; pick one in Settings)
ui_theme=liquid

# Added by look update
app_scan_roots=/usr/share/applications,/usr/local/share/applications
app_scan_depth=3
app_exclude_paths=
